# Configure these in the server environment; no values are loaded automatically.
DAYTONA_API_KEY=
NOSANA_API_KEY=
# Recommended: a chat-capable model ID from Nosana /v1/models (the first listed is an embedding model).
NOSANA_MODEL=qwen/qwen3.8-27b
# Optional: a Python Daytona snapshot with pip (ideally pytest==8.3.5 preinstalled).
DAYTONA_SNAPSHOT=
