# Copy to .env (gitignored); the app loads it automatically.
DAYTONA_API_KEY=
NOSANA_API_KEY=
# Optional: model preselected in the picker (the first listed Nosana model is an embedding model).
NOSANA_MODEL=qwen/qwen3.8-27b
# Optional: Daytona region (us or eu). Default is us.
DAYTONA_TARGET=us
# Optional: Neo4j code graph. Leave blank to run without it.
# Use neo4j+ssc:// instead of neo4j+s:// if your network breaks certificate checks.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
